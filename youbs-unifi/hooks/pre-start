#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
data_dir="${APP_DIR}/data"
init_script="${data_dir}/mongo-init/init-mongo.sh"
properties="${data_dir}/unifi/data/system.properties"
INFORM_PORT=8093

mkdir -p "${data_dir}/mongo" "${data_dir}/mongo-init" "${data_dir}/unifi" "${data_dir}/caddy"

# Page ouverte par Umbrel : redirige vers l'interface HTTPS du controleur (port 8944),
# sur le meme nom d'hote que celui du navigateur (umbrel.local, IP locale ou Tailscale).
# UniFi ne fonctionne pas derriere un proxy HTTP : cookies "Secure", controle
# d'origine, puis session perdue apres la validation par code de l'UI Account.
# Reecrit a chaque demarrage. Pas d'accolades dans la page : Caddy les lirait
# comme des variables.
cat > "${data_dir}/caddy/Caddyfile" <<'CADDY'
{
	admin off
	auto_https off
}

:8000 {
	header Content-Type "text/html; charset=utf-8"
	header Cache-Control "no-store"
	respond `<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"><title>UniFi Network</title></head>
<body style="font-family:sans-serif;padding:2em">
<p>Ouverture de UniFi Network en HTTPS...</p>
<p>Si rien ne se passe : <a id="lien" href="#">ouvrir le contrôleur</a>
(accepter l'avertissement de certificat, il est auto-signé).</p>
<script>
var url = "https://" + location.hostname + ":8944/manage/";
document.getElementById("lien").href = url;
if (window.top !== window.self) window.top.location.href = url;
else location.replace(url);
</script>
</body>
</html>` 200
}
CADDY

# Script de creation de l'utilisateur MongoDB du controleur (fourni par linuxserver).
# Les variables sont lues dans le conteneur mongo : heredoc entre quotes.
if [[ ! -f "${init_script}" ]]; then
  cat > "${init_script}" <<'SH'
#!/bin/bash

if which mongosh > /dev/null 2>&1; then
  mongo_init_bin='mongosh'
else
  mongo_init_bin='mongo'
fi
"${mongo_init_bin}" <<EOF
use ${MONGO_AUTHSOURCE}
db.auth("${MONGO_INITDB_ROOT_USERNAME}", "${MONGO_INITDB_ROOT_PASSWORD}")
db.createUser({
  user: "${MONGO_USER}",
  pwd: "${MONGO_PASS}",
  roles: [
    "clusterMonitor",
    { db: "${MONGO_DBNAME}", role: "dbOwner" },
    { db: "${MONGO_DBNAME}_stat", role: "dbOwner" },
    { db: "${MONGO_DBNAME}_audit", role: "dbOwner" },
    { db: "${MONGO_DBNAME}_restore", role: "dbOwner" }
  ]
})
EOF
SH
  chmod 755 "${init_script}"
fi

# Port inform : system.properties n'existe qu'apres le premier demarrage du
# controleur (cree par l'image avec les reglages MongoDB). Au premier lancement,
# c'est hooks/post-start qui ajoute le port puis redemarre le controleur.
if [[ -f "${properties}" ]] && ! grep -qx "unifi.http.port=${INFORM_PORT}" "${properties}"; then
  sed -i '/^unifi\.http\.port=/d' "${properties}"
  echo "unifi.http.port=${INFORM_PORT}" >> "${properties}"
fi
